# Builder (public key is exposed to the browser by design)
NEXT_PUBLIC_BUILDER_API_KEY=
# Private key: server only (content write APIs, private content preview). Never prefix with NEXT_PUBLIC_.
BUILDER_PRIVATE_API_KEY=

# Canonical site URL (metadata, sitemap, robots, hreflang), e.g. https://shop.example.com
NEXT_PUBLIC_SITE_URL=

# Shared secrets for internal API routes
# /api/content/create fails closed (503) until this is set; send as x-api-secret header
CONTENT_API_SECRET=
# /api/revalidate: enforced when set (append ?secret=... to the Builder webhook URL); required for GET in production
REVALIDATE_SECRET=

# Slack notifications (/api/notify-slack)
SLACK_WEBHOOK_URL=
